{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amog-fun",
  "compatibility_date": "2026-06-01",
  // Static site: every folder in ./public is a route.
  // public/foo/index.html  ->  https://amog.fun/foo
  // The Worker (worker/index.js) only runs for /api/*; everything else is served straight from the assets,
  // so page loads never count as Worker requests.
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Omegamac leaderboard. Schema in migrations/; apply with: npx wrangler d1 migrations apply amog-fun --remote
  // Secrets OMEGAMAC_SECRET (signs run tokens) and ADMIN_SECRET (worker/admin.js) are set with wrangler secret put;
  // locally they live in .dev.vars.
  "d1_databases": [
    { "binding": "DB", "database_name": "amog-fun", "database_id": "b858b3e2-0bf8-4ef8-ab37-e0fdea9834a2" }
  ],
  // Workers AI: checks each new leaderboard name once (worker/names.js). Always remote, even in wrangler dev (free tier).
  "ai": { "binding": "AI", "remote": true },
  // Online rooms for the Coefficient Choosing Game: one Durable Object (SQLite-backed, free plan) per room, worker/coefficients.js.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "CoeffRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CoeffRoom"] }],
  "routes": [
    { "pattern": "amog.fun", "custom_domain": true },
    { "pattern": "www.amog.fun", "custom_domain": true }
  ],
  "workers_dev": false
}
